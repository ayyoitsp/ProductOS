# ProductOS instance — copy to `.env`. ⛔ `.env` and `.env.*` are gitignored.
#
# Compose reads this file automatically, and so does anything run with
# `--env-file .env`. The whole configuration of an instance is three variables.

# Where the store is. ⛔ The instance REFUSES TO START without it rather than
# defaulting, because a guessed connection string is how something comes up
# pointed at the wrong Postgres and serves an empty corpus that reads as data loss.
#
# Leave unset to use the Postgres in docker-compose.yml.
# For Neon, quote it — the query string contains & which breaks shell sourcing:
#   DATABASE_URL="postgres://user:pass@ep-xxx.neon.tech/productos?sslmode=require"
#
# ⛔ PREFER THE POOLED ENDPOINT. Each request makes about five round trips on a
# read and eight or more on a write, so connection setup cost is paid often.
DATABASE_URL=""

PORT=4100

# ⛔ SET THIS ONLY ON A MACHINE THAT IS YOURS.
#
# Single-account mode runs the instance as one account with a standing session, so
# anything that can reach the port is signed in as that person. It exists because
# hosted-first is not hosted-only — a corpus that must never leave the machine
# gets the identical loop locally. On anything reachable by somebody else, LEAVE
# IT UNSET: signing in, or holding a token, is then the only way through.
PRODUCTOS_SINGLE_ACCOUNT=""
