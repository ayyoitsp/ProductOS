# ProductOS instance — copy to `.env`. ⛔ `.env` and `.env.*` are gitignored.
#
# Compose reads this file automatically, and so does anything run with
# `--env-file .env`. An instance needs three variables; signing in adds the block at the end.

# Where the store is. ⛔ The instance REFUSES TO START without it rather than
# defaulting, because a guessed connection string is how something comes up
# pointed at the wrong Postgres and serves an empty corpus that reads as data loss.
#
# Leave unset to use the Postgres in docker-compose.yml.
# For Neon, quote it — the query string contains & which breaks shell sourcing:
#   DATABASE_URL="postgres://user:pass@ep-xxx.neon.tech/productos?sslmode=require"
#
# ⛔ PREFER THE POOLED ENDPOINT. Each request makes about five round trips on a
# read and eight or more on a write, so connection setup cost is paid often.
DATABASE_URL=""

PORT=4100

# ⛔ SET THIS ONLY ON A MACHINE THAT IS YOURS.
#
# Single-account mode runs the instance as one account with a standing session, so
# anything that can reach the port is signed in as that person. It exists because
# hosted-first is not hosted-only — a corpus that must never leave the machine
# gets the identical loop locally. On anything reachable by somebody else, LEAVE
# IT UNSET: signing in, or holding a token, is then the only way through.
PRODUCTOS_SINGLE_ACCOUNT=""

# ---------------------------------------------------------------------------
# Signing in, and Claude connecting over OAuth
# ---------------------------------------------------------------------------
#
# The instance signs people in through the organization's own identity provider, over
# plain OIDC, and is its own OAuth server for Claude: a person adds
# https://<host>/p/<project>/mcp as a connector in claude.ai, Claude Desktop or Claude
# Code, approves it once, and Claude holds an hour-long token for that one project.
# ⛔ That token can draft and leave notes; it can never record anybody's agreement.
#
# Leave the issuer unset for no sign-in route (single-account mode, or a local stack).

# ⛔ REQUIRED WHEREVER ANYBODY ELSE CAN REACH THE INSTANCE. Redirects and the OAuth
# issuer are built from it; without it they come from each request's Host header.
PRODUCTOS_PUBLIC_URL=""        # https://productos.acme.com

# The provider. Register a web application there with the redirect URI
#   <PRODUCTOS_PUBLIC_URL>/auth/callback
#
#   Google Workspace  https://accounts.google.com  (consent screen: Internal)
#   Okta              https://<org>.okta.com
#   Entra ID          https://login.microsoftonline.com/<tenant-id>/v2.0
#   Keycloak          https://<host>/realms/<realm>
#   Clerk             https://<your-frontend-api>  (an OAuth application in Clerk)
PRODUCTOS_OIDC_ISSUER=""
PRODUCTOS_OIDC_CLIENT_ID=""
PRODUCTOS_OIDC_CLIENT_SECRET=""

# Who may sign in, comma-separated. Google is checked by the Workspace domain (`hd`),
# every other provider by the address's domain. Empty admits any verified address —
# project membership still decides what anybody can open.
PRODUCTOS_ALLOWED_DOMAINS=""   # acme.com

# ⛔ ENCRYPTS THE PROVIDER'S REFRESH TOKEN, WHICH IS HOW LEAVING IS NOTICED. Every
# hourly renewal of Claude's token asks the provider whether the person still exists
# there; removing them ends every token, connection and session they hold here. Without
# a secret nothing is kept, the provider is never asked again, and each approval lasts
# 7 days instead. Any long random string:  openssl rand -base64 32
PRODUCTOS_SECRET=""

# Default "openid email profile". Okta, Entra and Keycloak issue a refresh token only
# when asked: add offline_access. Google needs nothing added.
PRODUCTOS_OIDC_SCOPES=""

# ⛔ Entra ID sends no `email_verified`, so its addresses are refused until you set this —
# saying your provider only issues addresses your organization owns.
PRODUCTOS_OIDC_TRUST_EMAIL=""
