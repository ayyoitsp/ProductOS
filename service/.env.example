# Neon connection string (pooled endpoint recommended).
# Quote it — the query string contains & which breaks shell sourcing unquoted.
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# Agent/API credential: read + propose. Goes to the MCP bridge and CI.
# The service refuses to start without it. Generate with: openssl rand -hex 32
PRODUCTOS_SECRET=""

# Human credential: additionally permits validation. Held ONLY by the authoring
# app — never given to an agent. This is what makes "agents propose, humans
# validate" structural rather than conventional.
PRODUCTOS_HUMAN_SECRET=""

PORT=4100
